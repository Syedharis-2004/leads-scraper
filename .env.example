# ============================================
# AI Lead Generator - Environment Variables
# ============================================
#
# This file shows example configuration. Copy it to .env
# and adjust as needed. Most settings are managed through
# the dashboard UI and do not require environment variables.
#
# API keys are stored securely via Windows Credential Manager
# and should NEVER be placed in .env files.
# ============================================

# Backend host (default: 127.0.0.1 — localhost only)
# HOST=127.0.0.1

# Backend port (default: 8765)
# PORT=8765

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Disable ScrapeGraphAI telemetry
SCRAPEGRAPHAI_TELEMETRY_ENABLED=false
