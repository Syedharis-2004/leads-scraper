# ============================================
# AI Lead Generator - .gitignore
# ============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.Python
venv/
.venv/
env/
ENV/

# Environment / secrets
.env
.env.local
*.pem
*.key
data/.api_key_store.json
data/backend.pid

# Node / Angular
node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Data files (keep the directories, ignore contents)
data/*.csv
data/*.json
!data/.gitkeep

# Logs (keep the directory, ignore contents)
logs/*.log
!logs/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
